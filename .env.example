# AI六步法选品搜索引擎 v1.4 — 环境变量配置
# 复制此文件为 .env 并填入你的 Key
# cp .env.example .env 然后编辑

# ─────── 1688 产品数据搜索（强烈推荐） ───────
# 接入后可获得真实产品页：品牌/价格/产地/销量/供应商链接
# 获取方式：WorkBuddy → 设置 → 连接器 → LinkFox选品 → 复制 API Key
LINKFOX_AGENT_API_KEY=

# ─────── LLM 大模型（推荐配置1个） ───────
# 智谱 GLM-4-Flash — 永久免费，首选
# 注册: https://open.bigmodel.cn/ → API Keys
GLM_API_KEY=

# DeepSeek V3.2 — 约 ¥0.002/次搜索
# 注册: https://platform.deepseek.com/ → API Keys
DEEPSEEK_API_KEY=

# 通义千问 Qwen3-Plus — 约 ¥0.003/次搜索，200K上下文
# 注册: https://dashscope.aliyun.com/ → API-KEY管理
QWEN_API_KEY=
